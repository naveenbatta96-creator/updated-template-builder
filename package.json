{
  "name": "lockbox-template-builder",
  "version": "1.0.0",
  "dependencies": {
    "@cap-js/postgres": "^2.3.0",
    "@sap/cds": "^9",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^2.4",
    "cds-plugin-ui5": "^0.13.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-temolate-ui": "cds watch --open lockbox.templatebuilder.temolateui/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-template-ui": "cds watch --open com.template.builder.nats.templateui/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/temolate-ui",
    "app/template-ui"
  ]
}

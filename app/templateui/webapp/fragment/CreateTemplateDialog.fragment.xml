<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
>
    <Dialog
        id="createTemplateDialog"
        title="Create Template"
        contentWidth="1000px"
        draggable="true"
        resizable="true"
    >
        <content>
            <VBox class="sapUiMediumMargin">
                <!-- TOP ROW -->

                <HBox
                    width="100%"
                    alignItems="End"
                    class="sapUiSmallMarginBottom"
                >
                    <!-- TEMPLATE NAME -->

                    <VBox
                        width="70%"
                        class="sapUiSmallMarginEnd"
                    >
                        <Label text="Template Name" />

                        <Input
                            id="templateNameInput"
                            placeholder="Enter template name"
                        />
                    </VBox>

                    <!-- TEMPLATE TYPE -->

                    <VBox width="30%">
                        <Label text="Template Type"/>

                        <Select
                            id="templateTypeSelect"
                            selectedKey="LOCKBOX"
                            width="100%"
                        >
                            <items>
                                <core:Item
                                    key="AllLEVELS"
                                    text="All Levels"
                                />

                                <core:Item
                                    key="LOCKBOX"
                                    text="Lockbox"
                                />

                                <core:Item
                                    key="PAYMENT"
                                    text="Payment upload"
                                />

                                <core:Item
                                    key="CLEARING"
                                    text="Clearing upload" 
                                />
                            </items>
                        </Select>
                    </VBox>
                </HBox>
                <Table
                    id="fieldsTable"
                    mode="MultiSelect"
                    growing="true"
                    growingScrollToLoad="true"
                    class="sapUiMediumMarginTop"
                    items="{path: '/FieldMaster'}"
                >
                    <headerToolbar>
                        <Toolbar>
                            <Title text="Choose Fields" />

                            <ToolbarSpacer />

                            <Select
                                id="levelFilterSelect"
                                width="180px"
                                change=".onLevelFilterChange"
                                
                            >
                                <items>
                                    <core:Item
                                        key="ALL"
                                        text="All Levels"
                                    />

                                    <core:Item
                                        key="HEADER"
                                        text="Header"
                                    />

                                    <core:Item
                                        key="PAYMENT"
                                        text="Payment"
                                    />

                                    <core:Item
                                        key="CLEARING"
                                        text="Clearing"
                                    />
                                </items>
                            </Select>
                        </Toolbar>
                    </headerToolbar>

                    <columns>
                        <Column width="30%" >
                            <Text text="Level" />
                        </Column>

                        <Column width="50%">
                            <Text text="Field Name" />
                        </Column>

                        <Column width="20%">
                            <Text text="Type" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <!-- LEVEL TAG -->

                                <ObjectStatus
                                    text="{levelName}"
                                    state="Information"
                                />

                                <!-- FIELD NAME -->

                                <Text text="{fieldName}" />

                                <!-- SAP TYPE -->

                                <Text text="{sapType}" />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
                <!-- SHEET MODE -->
                <HBox
                    width="100%"
                    justifyContent="End"
                    class="sapUiMediumMarginTop"
                >
                    <VBox class="sapUiMediumMarginTop">
                        <Label text="Sheet Mode" />

                        <Select
                            id="sheetModeSelect"
                            selectedKey="SINGLE"
                            width="220px"
                        >
                            <items>
                                <core:Item
                                    key="SINGLE"
                                    text="Single Sheet"
                                />

                                <core:Item
                                    key="MULTIPLE"
                                    text="Multiple Sheets"
                                />
                            </items>
                        </Select>
                    </VBox>
                </HBox>
            </VBox>
        </content>

        <beginButton>
            <Button
                text="Save"
                type="Emphasized"
                press=".onSaveTemplate"
            />
        </beginButton>

        <endButton>
            <Button
                text="Cancel"
                press=".onCloseDialog"
            />
        </endButton>
    </Dialog>
</core:FragmentDefinition>

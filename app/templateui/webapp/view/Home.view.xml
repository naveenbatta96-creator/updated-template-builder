<mvc:View
    controllerName="com.template.builder.controller.Home"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
>
    <Page
        title="Template Builder"
        titleLevel="H1"
    >
        <content>
            <VBox class="sapUiMediumMargin">
                <OverflowToolbar>
                    <ToolbarSpacer />
                    <Button
                        text="Create Template"
                        type="Emphasized"
                        press=".onCreateTemplate"
                    />
                </OverflowToolbar>

                <!-- 
                <Button
                    text="Create Template"
                    type="Emphasized"
                    press=".onCreateTemplate"
                /> -->

                <Table
                    id="templateTable"
                    class="sapUiMediumMarginTop"
                    items="{
                     path: '/templateMasterWithCount'
                    }"
                        >
                    <columns>
                        <Column>
                            <Text text="Template Name" />
                        </Column>
                        <Column>
                            <Text text="Template Type" />
                        </Column>
                        <Column>
                            <Text text="Sheet Mode" />
                        </Column>
                        <Column>
                            <Text text="Total Fields" />
                        </Column>
                        <Column>
                            <Text text="Actions" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem
                            type="Navigation"
                            press=".onRowPress"
                        >
                            <cells>
                                <Text text="{templateName}" />
                                <Text text="{templateType}" />
                                <Text text="{sheetMode}" />

                                <Text text="{mappingsCount}" />

                                <Button
                                    text="Delete"
                                    type="Reject"
                                    press=".onDeleteTemplate"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
    </Page>
</mvc:View>

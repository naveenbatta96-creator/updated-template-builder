<mvc:View controllerName="lockbox.templatebuilder.templateui4map.controller.View1"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m">
    <!-- <Page id="page" title="{i18n>title}"> -->
     <Page title="Template Builder">
        <content>
            <VBox class="sapUiMediumMargin">
                <Button
                    id="createTemplateButton"
                    text="Create Template"
                    type="Emphasized"
                    press=".onCreateTemplate"
                />

                <Table
                    id="templateTable"
                    class="sapUiMediumMarginTop"
                    items="{
        path: '/TemplateMaster',
        parameters: {
            $expand: 'mappings'
        }
    }"
                >
                    <columns>
                        <Column>
                            <Text text="Template Name" />
                        </Column>
                        <Column>
                            <Text text="Template Type" />
                        </Column>
                        <Column>
                            <Text text="Sheet Mode" />
                        </Column>
                        <Column>
                            <Text text="Total Fields" />
                        </Column>
                        <Column>
                            <Text text="Actions" />
                        </Column>
                    </columns>

                    <items>
                        <ColumnListItem>
                            <cells>
                                <Text text="{templateName}" />
                                <Text text="{templateType}" />
                                <Text text="{sheetMode}" />

                                <Text text="{= ${mappings}.length || 0 }" />

                                <Button
                                    id="deleteTemplateButton"
                                    text="Delete"
                                    type="Reject"
                                    press=".onDeleteTemplate"
                                />
                            </cells>
                        </ColumnListItem>
                    </items>
                </Table>
            </VBox>
        </content>
        <List
            headerText="Saved Templates Monitor"
            items="{templateModel>/templates}"
            noDataText="No templates saved in this session yet"
            class="sapUiMediumMarginTop"
        >
            <items>
                <StandardListItem
                    title="{templateModel>name}"
                    description="Type: {templateModel>type} | Mode: {templateModel>sheetMode}"
                    info="Fields Selected: {= ${templateModel>selectedFields}.length }"
                />
            </items>
        </List>
    </Page>
    <!-- </Page> -->
</mvc:View>